# Copy to your ESPHome config folder as secrets.yaml and fill in.
# Generate each API key with: openssl rand -base64 32

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

snapmaker_u1_api_key: "replace-with-32-byte-base64-key"
k2_plus_api_key: "replace-with-32-byte-base64-key"
p1s_api_key: "replace-with-32-byte-base64-key"
